# Caddy de la app: sirve la web y reenvía /api a FastAPI. Escucha en HTTP en el 8080.
# El HTTPS (obligatorio para el service worker y las push) lo pone el Caddy compartido
# del VPS, que llega aquí por la red `proxy` con el alias psst-web.
{
	admin off
	auto_https off
	servers {
		# Las peticiones llegan del Caddy compartido: nos fiamos de su X-Forwarded-For
		# para conservar la IP real del cliente.
		trusted_proxies static private_ranges
	}
}

:8080 {
	# Para el healthcheck del contenedor.
	handle /healthz {
		respond "ok" 200
	}

	# La API, también los websockets (Caddy los reenvía sin configurar nada más).
	# handle_path quita el prefijo: /api/groups/... llega a FastAPI como /groups/...
	# psst-api es un alias único en la red interna: `api` a secas podría ser otra app.
	handle_path /api/* {
		reverse_proxy psst-api:8000
	}

	handle {
		root * /srv

		# Los ficheros de assets/ llevan un hash en el nombre: se pueden cachear para siempre.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Todo lo demás (index.html, sw.js, el manifest, los iconos y las rutas de la SPA)
		# se revalida siempre: así las versiones nuevas llegan. Se decide por la ruta
		# pedida, antes de try_files, para que /g/abc/chat (que sirve index.html) también.
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"

		# Rutas de la SPA (/g/abc/chat…): si no es un fichero, index.html.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
