# Variables de producción (https://psst.hidan.es). Solo placeholders.
# El contenido real va en el secret de GitHub VPS_ENV_FILE; el workflow de despliegue
# lo escribe en /srv/psst/.env con permisos 600. Nunca se commitea.

# Contraseña de Postgres. En hexadecimal para que no rompa la URL de conexión:
#   openssl rand -hex 32
POSTGRES_PASSWORD=cambia-esto

# Origen público de la web: CORS y comprobación del Origin del websocket.
PSST_WEB_ORIGIN=https://psst.hidan.es
# La cookie de sesión solo viaja por HTTPS.
PSST_COOKIE_SECURE=true

# Notificaciones push. Genera las claves con:
#   cd apps/api && uv run python -m scripts.gen_vapid
PSST_VAPID_PRIVATE_KEY=cambia-esto
PSST_VAPID_PUBLIC_KEY=cambia-esto
PSST_VAPID_SUBJECT=mailto:tu@correo.com
