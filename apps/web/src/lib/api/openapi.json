    "/groups/{slug}/draw": {
      "post": {
        "tags": [
          "draw"
        ],
        "summary": "Make Draw",
        "description": "Hace el sorteo (o lo repite si nadie ha visto todavía su resultado).\n\nTodo ocurre en una transacción: o se guardan todas las asignaciones y el grupo pasa a\n\"drawn\", o no cambia nada. La respuesta no dice nada de quién regala a quién: el\norganizador también participa y solo ve lo suyo.",
        "operationId": "make_draw_groups__slug__draw_post",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
