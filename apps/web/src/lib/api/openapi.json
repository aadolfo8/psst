  "components": {
    "schemas": {
      "ChatSummary": {
        "properties": {
          "as_giver": {
            "type": "integer",
            "title": "As Giver"
          },
          "as_receiver": {
            "type": "integer",
            "title": "As Receiver"
          }
        },
        "type": "object",
        "required": [
          "as_giver",
          "as_receiver"
        ],
        "title": "ChatSummary",
        "description": "Mensajes sin leer en cada conversación, para las pestañas y la sala."
      },
      "Conversation": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "giver",
              "receiver"
            ],
            "title": "Role"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageOut"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "role",
          "messages"
        ],
        "title": "Conversation"
      },
      "ExclusionCreate": {
        "properties": {
          "participant_a_id": {
            "type": "string",
            "format": "uuid",
            "title": "Participant A Id"
          },
          "participant_b_id": {
            "type": "string",
            "format": "uuid",
            "title": "Participant B Id"
          }
        },
        "type": "object",
        "required": [
          "participant_a_id",
          "participant_b_id"
        ],
        "title": "ExclusionCreate"
      },
      "ExclusionOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "participant_a": {
            "$ref": "#/components/schemas/ParticipantRef"
          },
          "participant_b": {
            "$ref": "#/components/schemas/ParticipantRef"
          }
        },
        "type": "object",
        "required": [
          "id",
          "participant_a",
          "participant_b"
        ],
        "title": "ExclusionOut"
      },
      "GroupCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "budget": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget",
            "description": "En euros"
          },
          "exchange_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange Date"
          },
          "admin_name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Admin Name"
          },
          "pin": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "title": "Pin"
          }
        },
        "type": "object",
        "required": [
          "name",
          "admin_name",
          "pin"
        ],
        "title": "GroupCreate"
      },
      "GroupPublic": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "budget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Budget"
          },
          "exchange_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "drawn"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "budget",
          "exchange_date",
          "status"
        ],
        "title": "GroupPublic"
      },
      "GroupStatusUpdate": {
        "properties": {
